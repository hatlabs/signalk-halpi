#!/bin/sh
set -e

SK_DATA="/var/lib/container-apps/marine-signalk-server-container/data/data"
SK_SERVICE="marine-signalk-server-container.service"

case "$1" in
    remove)
        # Remove the symlink (leave system-plugins intact for reinstall)
        rm -f "$SK_DATA/node_modules/signalk-halpi"

        # Remove file: dependency from package.json
        PKG_JSON="$SK_DATA/package.json"
        if [ -f "$PKG_JSON" ]; then
            python3 -c "
import json
with open('$PKG_JSON') as f:
    pkg = json.load(f)
pkg.get('dependencies', {}).pop('signalk-halpi', None)
with open('$PKG_JSON', 'w') as f:
    json.dump(pkg, f, indent=2)
    f.write('\n')
" || true
        fi

        # Restart Signal K so it stops loading the plugin
        # --no-block: Signal K is ordered behind a provisioning one-shot with no
        # start timeout, and a blocking restart holds the dpkg lock for as long as
        # that waits -- which is indefinitely on a device with no uplink.
        if [ -d /run/systemd/system ]; then
            systemctl restart --no-block "$SK_SERVICE" || true
        fi
        ;;
    purge)
        # Remove symlink
        rm -f "$SK_DATA/node_modules/signalk-halpi"

        # Remove file: dependency from package.json
        PKG_JSON="$SK_DATA/package.json"
        if [ -f "$PKG_JSON" ]; then
            python3 -c "
import json
with open('$PKG_JSON') as f:
    pkg = json.load(f)
pkg.get('dependencies', {}).pop('signalk-halpi', None)
with open('$PKG_JSON', 'w') as f:
    json.dump(pkg, f, indent=2)
    f.write('\n')
" || true
        fi

        # Remove plugin config
        rm -f "$SK_DATA/plugin-config-data/signalk-halpi.json"

        # Restart Signal K
        if [ -d /run/systemd/system ]; then
            systemctl restart --no-block "$SK_SERVICE" || true
        fi
        ;;
esac

exit 0
