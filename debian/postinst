#!/bin/sh
set -e

SK_DATA="/var/lib/container-apps/marine-signalk-server-container/data/data"
SK_SERVICE="marine-signalk-server-container.service"

case "$1" in
    configure)
        # Register as a file: dependency in package.json so npm preserves the
        # symlink across future npm install operations (e.g., when prestart.sh
        # installs other plugins).
        if [ -d "$SK_DATA/system-plugins/signalk-halpi" ]; then
            mkdir -p "$SK_DATA/node_modules"
            ln -sfn ../system-plugins/signalk-halpi "$SK_DATA/node_modules/signalk-halpi"

            # Add file: dependency to package.json (idempotent).
            # Create a minimal package.json if it doesn't exist yet —
            # without it, the first npm install would prune the symlink.
            PKG_JSON="$SK_DATA/package.json"
            python3 -c "
import json, os
path = '$PKG_JSON'
if os.path.isfile(path):
    with open(path) as f:
        pkg = json.load(f)
else:
    pkg = {}
deps = pkg.setdefault('dependencies', {})
deps['signalk-halpi'] = 'file:system-plugins/signalk-halpi'
with open(path, 'w') as f:
    json.dump(pkg, f, indent=2)
    f.write('\n')
"
        fi

        # Auto-enable plugin on first install (don't override existing config)
        CONFIG_DIR="$SK_DATA/plugin-config-data"
        CONFIG_FILE="$CONFIG_DIR/signalk-halpi.json"
        if [ ! -f "$CONFIG_FILE" ]; then
            mkdir -p "$CONFIG_DIR"
            cat > "$CONFIG_FILE" << 'CONF'
{
  "enabled": true,
  "enableLogging": false,
  "enableDebug": false,
  "configuration": {
    "pathPrefix": "electrical.halpi"
  }
}
CONF
        fi

        # Restart Signal K to pick up the plugin
        # --no-block: Signal K is ordered behind a provisioning one-shot with no
        # start timeout, and a blocking restart holds the dpkg lock for as long as
        # that waits -- which is indefinitely on a device with no uplink.
        if [ -d /run/systemd/system ]; then
            systemctl restart --no-block "$SK_SERVICE" || true
        fi
        ;;
esac

exit 0
